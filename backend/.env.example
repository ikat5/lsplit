# Copy this file to `.env` for local development and fill in real values.
# On Render, set these as Environment Variables in the dashboard instead — do NOT commit the real .env.
#
# IMPORTANT (Neon): use the JDBC form and DO NOT include `channel_binding=require`.
# The PostgreSQL JDBC driver mishandles that libpq parameter and the connection gets closed.
DB_URL=jdbc:postgresql://<your-neon-host>-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password
JWT_SECRET=replace_with_a_long_random_hex_string
